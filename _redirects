# Netlify: block files that must never be served publicly.
# The ! forces the rule even though a real file exists at that path
# (without it, Netlify serves the static file and ignores the rule).
#
# js/admin-seed.js holds every secret in The Speckled Band, including
# the solution. Firestore rules cannot protect a static file — only
# not serving it can.
/js/admin-seed.js   /404.html   404!
/admin/seed.html    /404.html   404!

# No reason to serve these either.
/firestore.rules    /404.html   404!
/SETUP.md           /404.html   404!
