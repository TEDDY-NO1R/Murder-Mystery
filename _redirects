# Netlify: block files that must never be served publicly.
# The ! forces the rule even though a real file exists at that path
# (without it, Netlify serves the static file and ignores the rule).
#
# js/stories/ and js/admin-seed.js hold every story, solutions
# included. Firestore rules cannot protect a static file — only not
# serving it can.
/js/admin-seed.js   /404.html   404!
/js/stories/*       /404.html   404!
/admin/seed.html    /404.html   404!

# No reason to serve these either.
/firestore.rules    /404.html   404!
/SETUP.md           /404.html   404!

# Hosting moved onto the main page (anyone can host from there).
# Send old links to it rather than to a 404.
/host.html          /           301

# The bare domain should open the game, not a 404. A 200 rewrite serves
# play.html at / without changing the address bar, so the shared link and
# the og:url agree.
/                   /play.html  200
