rules_version = '2';

// ============================================================
//  MURDER MYSTERY — Firestore Security Rules
// ============================================================
//
//  Project: murder-mystery-online
//  Story-editor UID is filled in (hasthimunisilva@icloud.com).
//
//  Model (Oct 2026): anyone can host. The host is a player like
//  everyone else; their browser deals the cards but never shows
//  a secret on screen. That means any signed-in browser may READ
//  stories — so the host's honesty, not these rules, keeps the
//  solution hidden. Deliberately accepted for now; a server-side
//  dealer would be needed to make it cheat-proof.
//
//  What the rules still enforce:
//    - only the story editor can WRITE stories;
//    - only a room's own host can run that room;
//    - a player's card is fetched only by that player (the host
//      writes it but the screen never shows it);
//    - joining only while the lobby is open, one final vote per
//      dealt player, and the ending is unreadable before 'reveal';
//    - one search per player per round, each find claimed once,
//      and only its finder can show it to the table.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    //  Identity helpers
    // ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Players sign in anonymously. Anonymous == untrusted, always.
    function isAnonymous() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // The story editor. Two independent conditions, on purpose:
    // the UID allowlist is the real gate, and the anonymous check is a
    // second lock in case a sign-in provider is ever added carelessly.
    // Add more UIDs to the list to allow more editors. (Hosting a game
    // needs no allowlist — see isHostOf.)
    function isAdmin() {
      return isSignedIn()
          && !isAnonymous()
          && request.auth.uid in [
               'B8CkPp6XqTcHfvOcZHE8ghqNahI3'  // hasthimunisilva@icloud.com
             ];
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------
    //  Session helpers
    // ---------------------------------------------------------

    // Child documents can outlive their session (Firestore does not
    // cascade deletes), so every player-facing child rule checks
    // that the parent still exists. A closed room's leftovers are
    // unreadable even if cleanup was interrupted.
    function sessionExists(sid) {
      return exists(/databases/$(database)/documents/sessions/$(sid));
    }

    function sessionData(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data;
    }

    // Has this user actually joined this (still existing) session?
    function isMember(sid) {
      return isSignedIn()
          && sessionExists(sid)
          && exists(/databases/$(database)/documents/sessions/$(sid)/players/$(request.auth.uid));
    }

    // Read the live phase off the session doc. This is what makes
    // "you cannot fetch the answer before the reveal" a database
    // fact rather than a UI promise.
    function phaseIs(sid, p) {
      return sessionData(sid).currentPhase == p;
    }

    // Joining is only possible while the host is still gathering
    // guests. The join screen checks this too, but a direct client
    // request must be refused here, not there.
    function lobbyIsOpen(sid) {
      return sessionExists(sid)
          && sessionData(sid).status == 'open'
          && sessionData(sid).currentPhase == 'lobby';
    }

    // The player who opened this room. Only they (or the story
    // editor) may deal, pace, release clues and close it.
    function isHostOf(sid) {
      return isSignedIn() && sessionData(sid).hostUid == request.auth.uid;
    }

    function controls(sid) {
      return isAdmin() || isHostOf(sid);
    }

    // =========================================================
    //  STORIES — readable by any signed-in browser, written only
    //  by the story editor.
    //
    //  The host's browser reads the characters and clues in
    //  order to deal and release them, and the story picker
    //  lists the titles. Nothing secret is ever drawn on screen.
    // =========================================================

    match /stories/{storyId} {

      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /characters/{characterId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /phases/{phaseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      // Rooms of the house and the evidence hidden in each.
      match /locations/{locationId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // =========================================================
    //  SESSIONS
    //
    //  The document ID *is* the room code (e.g. sessions/RAVEN).
    //  That means joining is a direct lookup, so players never
    //  need permission to query the sessions collection — and
    //  `list` stays admin-only, which blocks enumeration of
    //  other people's games entirely.
    // =========================================================

    match /sessions/{sessionId} {

      // Anyone signed in can look up a room code they were told.
      // Contains: roomCode, storyId, storyTitle, storySynopsis,
      // status, currentPhase, revealedClues[], hostUid, createdAt.
      //
      // revealedClues holds the full text of clues the host has
      // already released — released clues are public to the table
      // by definition. No character, role or solution data ever
      // goes in this document.
      allow get: if isSignedIn();

      allow list: if isAdmin();

      // Anyone signed in may open a room, as its own host, in the
      // lobby. Creating over an existing code counts as an update,
      // which only that room's host may do — so a live game cannot
      // be hijacked by guessing its code.
      allow create: if isSignedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.currentPhase == 'lobby';

      // Only the room's host advances phases, releases clues, or
      // ends the game, and cannot hand the room to someone else.
      allow update: if isAdmin()
                    || (resource.data.hostUid == request.auth.uid
                        && request.resource.data.hostUid == resource.data.hostUid);
      allow delete: if isAdmin() || resource.data.hostUid == request.auth.uid;

      // -------------------------------------------------------
      //  players/{uid} — public within the game
      //
      //  The lobby list and the ballot are built from these, so
      //  every player can read them. They hold no secrets: a
      //  display name, a join time, and (once dealt) the public
      //  in-fiction character name. Role, secret and objective
      //  live in /private, never here.
      // -------------------------------------------------------
      match /players/{playerId} {

        function validNewPlayer() {
          return request.resource.data.keys().hasOnly(['name', 'joinedAt'])
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 1
              && request.resource.data.name.size() <= 24
              // Forces serverTimestamp() — a client cannot backdate
              // itself to the front of the join queue.
              && request.resource.data.joinedAt == request.time;
        }

        // A player may rename themselves and nothing else. In
        // particular they cannot award themselves a characterName.
        function validPlayerUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 1
              && request.resource.data.name.size() <= 24;
        }

        // Your own record, or the roster of a room you are in.
        allow get:  if (isSelf(playerId) && sessionExists(sessionId))
                    || isMember(sessionId)
                    || controls(sessionId);
        allow list: if isMember(sessionId) || controls(sessionId);

        // No late joins: a phone cannot add itself once the host has
        // dealt, so it can never qualify to vote or read the reveal.
        // Overcrowding is handled by the host, who can remove guests
        // from the lobby and cannot deal more than the game's maximum.
        allow create: if isSelf(playerId) && validNewPlayer() && lobbyIsOpen(sessionId);
        allow update: if (isSelf(playerId) && sessionExists(sessionId) && validPlayerUpdate())
                      || controls(sessionId);
        allow delete: if controls(sessionId);
      }

      // -------------------------------------------------------
      //  private/{uid} — each player's dealt card
      //
      //  At game start the host's browser writes each player's
      //  card here, keyed by that player's auth UID. Other players
      //  are refused it. The host may list the collection (needed
      //  to clean the room up) but the host screen never shows it.
      //
      //  Only the host writes cards, so a player cannot re-deal
      //  themselves out of being the killer.
      // -------------------------------------------------------
      match /private/{playerId} {
        allow get: if (isSelf(playerId) && sessionExists(sessionId)) || controls(sessionId);
        allow list: if controls(sessionId);
        allow create, update, delete: if controls(sessionId);
      }

      // -------------------------------------------------------
      //  votes/{uid}
      //
      //  Secret ballot. You see your own vote; you see everyone's
      //  only once the host reaches the reveal. Votes can only be
      //  cast during the accusation phase, by a player who was
      //  actually dealt a character, for themselves, naming another
      //  character who is really in this game. Votes are final:
      //  there is no update, matching the locked ballot in the UI.
      // -------------------------------------------------------
      match /votes/{playerId} {

        // castIds is written into the session by the host when it
        // deals. It holds character ids only (already public on the
        // players documents), sorted, so it reveals no roles.
        function validVote() {
          let me      = get(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.auth.uid)).data;
          let castIds = sessionData(sessionId).get('castIds', []);
          let vote    = request.resource.data;
          return vote.keys().hasOnly(['suspectId', 'castAt'])
              && vote.keys().hasAll(['suspectId', 'castAt'])
              && vote.suspectId is string
              && vote.suspectId in castIds
              && me.get('characterId', '') != ''
              && vote.suspectId != me.characterId
              && vote.castAt == request.time;
        }

        // The host may count votes (to know when everyone has
        // accused) and must list them to clean up; the host screen
        // shows only how many have voted, never for whom.
        allow get: if (isSelf(playerId) && sessionExists(sessionId))
                   || controls(sessionId)
                   || (isMember(sessionId) && phaseIs(sessionId, 'reveal'));

        allow list: if controls(sessionId)
                    || (isMember(sessionId) && phaseIs(sessionId, 'reveal'));

        allow create: if isSelf(playerId)
                      && isMember(sessionId)
                      && phaseIs(sessionId, 'accusation')
                      && validVote();

        allow update: if false;
        allow delete: if controls(sessionId);
      }

      // -------------------------------------------------------
      //  reveal/{docId}
      //
      //  Who did it, how, and why. The host writes this at game
      //  start, but the read is gated on the session's live phase,
      //  so it is unfetchable from the room until the reveal.
      // -------------------------------------------------------
      match /reveal/{docId} {
        allow read: if isAdmin()
                    || (isMember(sessionId) && phaseIs(sessionId, 'reveal'));
        allow write: if controls(sessionId);
      }

      // -------------------------------------------------------
      //  Searching the house
      //
      //  searches/{uid}_{phase} — who searched which room in which
      //    round. One per player per round (the id enforces it),
      //    public to the table. Says nothing about what was found.
      //  finds/{findId} — which player holds each piece of
      //    evidence. Create-only, so a find can be claimed once;
      //    written in the same batch as the search that found it.
      //  shared/{findId} — evidence its finder chose to show the
      //    whole table.
      // -------------------------------------------------------

      // Must match SEARCH_PHASES in js/firebase-init.js.
      function canSearchNow(phase) {
        return phase in ['arrival', 'investigation', 'confrontation']
            && sessionData(sessionId).currentPhase == phase;
      }

      function isDealt() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.auth.uid))
                 .data.get('characterId', '') != '';
      }

      match /searches/{searchId} {
        allow read: if isMember(sessionId) || controls(sessionId);
        allow create: if isSelf(request.resource.data.uid)
                      && searchId == request.resource.data.uid + '_' + request.resource.data.phase
                      && request.resource.data.keys().hasOnly(['uid', 'locationId', 'phase', 'findId', 'at'])
                      && request.resource.data.locationId is string
                      && request.resource.data.at == request.time
                      && canSearchNow(request.resource.data.phase)
                      && isMember(sessionId)
                      && isDealt()
                      && (request.resource.data.findId == null
                          || getAfter(/databases/$(database)/documents/sessions/$(sessionId)/finds/$(request.resource.data.findId)).data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if controls(sessionId);
      }

      match /finds/{findId} {
        allow read: if isMember(sessionId) || controls(sessionId);
        allow create: if isSelf(request.resource.data.uid)
                      && request.resource.data.keys().hasOnly(['uid', 'locationId', 'phase', 'at'])
                      && request.resource.data.at == request.time
                      && getAfter(/databases/$(database)/documents/sessions/$(sessionId)/searches/$(request.auth.uid + '_' + request.resource.data.phase)).data.findId == findId;
        allow update: if false;
        allow delete: if controls(sessionId);
      }

      // Only the player holding a find may show it, once, while the
      // game is live. (The text is copied in by the finder's phone —
      // part of the honour system.)
      match /shared/{findId} {
        allow read: if isMember(sessionId) || controls(sessionId);
        allow create: if isSelf(request.resource.data.uid)
                      && get(/databases/$(database)/documents/sessions/$(sessionId)/finds/$(findId)).data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'text', 'at'])
                      && request.resource.data.at == request.time
                      && sessionData(sessionId).status == 'live';
        allow update: if false;
        allow delete: if controls(sessionId);
      }
    }

    // =========================================================
    //  Everything else: denied.
    //  Firestore denies unmatched paths by default; this is here
    //  so the intent is explicit to anyone reading the file.
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
